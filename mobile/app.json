{
  "expo": {
    "name": "WordRushMF",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "gameonmaker",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.marekficht.gameonmaker",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.wordrushmf.game",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "delay_app_measurement_init": true,
          "userTrackingUsageDescription": "Ta aplikacja korzysta z danych reklamowych, aby wyświetlać dopasowane reklamy."
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Ta aplikacja korzysta z danych reklamowych, aby wyświetlać dopasowane reklamy."
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.com.googleusercontent.apps.1045622351349-mlupqtdoae4d3d9n3sul9ag9npdgvs93"
        }
      ],
      "expo-apple-authentication",
      "expo-router"
    ],
    "extra": {
      "eas": {
        "projectId": "112dbd96-e572-498a-bce4-9d8fcc15909c"
      }
    },
    "owner": "marekficht"
  }
}
