# Firebase — required. Get values from Firebase Console → Project Settings.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# AdMob — fill in before Phase 4. Register at admob.google.com (free).
# Leave blank to use test ad IDs during development.
EXPO_PUBLIC_ADMOB_APP_ID_IOS=TODO_FILL_LATER
EXPO_PUBLIC_ADMOB_APP_ID_ANDROID=TODO_FILL_LATER
EXPO_PUBLIC_ADMOB_REWARDED_ID=TODO_FILL_LATER
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID=TODO_FILL_LATER
EXPO_PUBLIC_ADMOB_BANNER_ID=TODO_FILL_LATER

# RevenueCat — fill in before Phase 5. Register at revenuecat.com (free up to $2500 MRR).
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=TODO_FILL_LATER
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=TODO_FILL_LATER
